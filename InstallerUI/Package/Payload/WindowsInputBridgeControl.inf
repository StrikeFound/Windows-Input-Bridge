[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=WindowsInputBridgeControl.cat
DriverVer=10/24/2026,0.1.0.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299
[Models.NTamd64.10.0...16299]
%Name%=Control,ROOT\WindowsInputBridgeControl
[Control.NT]
CopyFiles=Files
[Control.NT.Services]
AddService=WindowsInputBridge,2,Service
AddService=WindowsInputBridgeDemoClock,0,TrialClockService
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WindowsInputBridge.sys
[Control.NT.Wdf]
KmdfService=WindowsInputBridge,Wdf
[Wdf]
KmdfLibraryVersion=1.15
[DestinationDirs]
Files=13
[Files]
InputSessionClock.sys
WindowsInputBridge.sys
[SourceDisksNames]
1=%Provider%,,,
[SourceDisksFiles]
InputSessionClock.sys=1
WindowsInputBridge.sys=1
[Strings]
Provider="InputBridge Project"
Name="InputBridge Control Endpoint"
ServiceName="WindowsInputBridge"

[TrialClockService]
DisplayName="TitanCSA per-boot demo clock"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\InputSessionClock.sys
